 }
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct SwitchAgentParams {
+    pub conversation_id: i32,
+    pub expected_agent: AgentType,
+    pub expected_session_id: Option<String>,
+    pub target_agent: AgentType,
+}
+
+pub async fn acp_switch_agent(
+    Extension(state): Extension<Arc<AppState>>,
+    Json(params): Json<SwitchAgentParams>,
+) -> Result<Json<()>, AppCommandError> {
+    acp_commands::verify_agent_installed(params.target_agent)
+        .await
+        .map_err(|e| AppCommandError::task_execution_failed(e.to_string()))?;
+    state
+        .connection_manager
+        .switch_conversation_agent(
+            &state.db,
+            state.emitter.clone(),
+            params.conversation_id,
+            params.expected_agent,
+            params.expected_session_id,
+            params.target_agent,
+        )
+        .await
+        .map_err(switch_agent_error)?;
+    Ok(Json(()))
+}
+
+#[derive(Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct CompactConversationParams {
+    pub conversation_id: i32,
+    pub expected_agent: AgentType,
+    pub expected_session_id: Option<String>,
+}
+
+pub async fn acp_compact_conversation(
+    Extension(state): Extension<Arc<AppState>>,
+    Json(params): Json<CompactConversationParams>,
+) -> Result<Json<()>, AppCommandError> {
+    state
+        .connection_manager
+        .compact_conversation(
+            &state.db,
+            state.emitter.clone(),
+            params.conversation_id,
+            params.expected_agent,
+            params.expected_session_id,
+        )
+        .await
+        .map_err(switch_agent_error)?;
+    Ok(Json(()))
+}
+
+fn switch_agent_error(error: AcpError) -> AppCommandError {
+    let message = error.to_string();
+    match error {
+        AcpError::ConversationChanged(_) => {
+            AppCommandError::new(AppErrorCode::ConversationChanged, message)
+        }
+        other => AppCommandError::task_execution_failed(other.to_string()),
+    }
+}
+
+#[cfg(test)]
+mod switch_agent_error_tests {
+    use super::*;
+    use axum::{http::StatusCode, response::IntoResponse};
+
+    #[test]
+    fn stale_switch_is_a_typed_conflict_not_a_server_failure() {
+        let error = switch_agent_error(AcpError::ConversationChanged("reload".into()));
+        assert_eq!(
+            serde_json::to_value(&error).unwrap()["code"],
+            "conversation_changed"
+        );
+        assert_eq!(error.into_response().status(), StatusCode::CONFLICT);
+        // Genuine failures still surface as 500; do not infer conflicts from text.
+        let failure = switch_agent_error(AcpError::protocol("Conversation changed"));
+        assert_eq!(
+            failure.into_response().status(),
+            StatusCode::INTERNAL_SERVER_ERROR
+        );
+    }
+}
